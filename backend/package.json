{
  "name": "restaurant-pos-backend",
  "version": "1.0.0",
  "description": "Restaurant POS & Management System API",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma migrate reset --force",
    "db:embedded": "node scripts/start-embedded-db.js",
    "test": "NODE_ENV=test jest --runInBand --forceExit"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "pos",
    "restaurant"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "embedded-postgres": "^18.6.0-beta.19",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prisma": "^6.5.0",
    "supertest": "^7.0.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "bcrypt@5.1.1": true,
    "prisma@6.19.3": true,
    "@embedded-postgres/linux-x64@18.6.0-beta.19": true
  }
}
