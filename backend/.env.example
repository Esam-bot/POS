NODE_ENV=development
PORT=4000

# System PostgreSQL (primary)
DATABASE_URL=postgresql://postgres:newpassword123@localhost:5432/pos_db?schema=public

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=2097152
# Optional Cloudinary (falls back to local disk uploads when unset)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
