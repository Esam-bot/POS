NODE_ENV=development
PORT=6000
# Docker Compose Postgres (port 5432):
# DATABASE_URL=postgresql://pos:pos_secret@127.0.0.1:5432/restaurant_pos?schema=public
# Embedded local helper `npm run db:embedded` (port 5433):
DATABASE_URL=postgresql://pos:pos_secret@127.0.0.1:5433/restaurant_pos?schema=public
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=2097152
# Optional Cloudinary (falls back to local disk uploads when unset)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
